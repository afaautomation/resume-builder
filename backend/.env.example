# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project: https://xgnluardsgflfxttvgwc.supabase.co (same project as the main site)
SUPABASE_URL=https://xgnluardsgflfxttvgwc.supabase.co
# SECRET key — Supabase dashboard -> Settings -> API Keys -> "Secret keys".
# Bypasses Row Level Security. Never expose this to any frontend code.
SUPABASE_SERVICE_ROLE_KEY=paste_your_supabase_service_role_secret_key_here

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Comma-separated. Calls rotate across keys and fall back key-by-key when one
# hits its limit. Google counts limits per PROJECT, so each key must come from
# a different Google Cloud project to add quota.
GEMINI_API_KEYS=key1,key2
# Optional: override the model order (comma-separated, tried left to right).
# GEMINI_FAST_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_HEAVY_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Optional fallbacks, tried in this order after every Gemini key/model.
# Leave a key empty if that account has no credits — it only adds delay.
XAI_API_KEY=
XAI_MODEL=grok-3-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── PDF / Puppeteer ──────────────────────────────────────────────────────────
PDF_OUTPUT_DIR=./exports
PUPPETEER_HEADLESS=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# 1. From Meta for Developers (developers.facebook.com) -> Your WhatsApp App -> API Setup:
WHATSAPP_PHONE_NUMBER_ID=paste_your_meta_phone_number_id_here
# 2. Permanent System User Access Token (with whatsapp_business_messaging permission):
WHATSAPP_ACCESS_TOKEN=paste_your_meta_access_token_here
# 3. (Optional) Approved Authentication Template Name in WhatsApp Business Manager:
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

