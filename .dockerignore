.git
.gitignore
.vscode/
# Secrets never go into the image; Cloud Run reads them from Secret Manager.
**/.env
**/.env.*
!backend/.env.example
**/node_modules/
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/uploads/
backend/logs/
backend/exports/
backend/tests/
npm-debug.log
render.yaml
app.js
